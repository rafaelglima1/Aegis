# AEGIS V1.3 — Environment Configuration

# Application
APP_NAME=AEGIS
APP_VERSION=1.3.0
LOG_LEVEL=INFO

# Trading Environment
TRADING_ENVIRONMENT=SANDBOX

# Live Trading Gates (disabled by default)
LIVE_ENABLED=false
LIVE_CONFIRMATION_REQUIRED=true

# Database
DATABASE_URL=postgresql+asyncpg://aegis:aegis@localhost:5432/aegis
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Provider
LLM_PROVIDER=openai
LLM_API_KEY=changeme
LLM_MODEL=gpt-4

# Broker — Sandbox
SANDBOX_API_KEY=changeme
SANDBOX_API_SECRET=changeme

# Broker — Live (disabled by default)
LIVE_API_KEY=changeme
LIVE_API_SECRET=changeme
