# AEGIS V1.3 — Environment Configuration
# All values flow through Settings (single source of truth)

# Application
APP_NAME=AEGIS
APP_VERSION=1.3.0
LOG_LEVEL=INFO

# Environment
TRADING_ENVIRONMENT=SANDBOX
LIVE_ENABLED=false
LIVE_CONFIRMATION_REQUIRED=true

# Capital & Positions
TRADING_CAPITAL=100.00
MAX_POSITIONS=1

# Trading
TRADING_SYMBOLS=BTC-BRL,ETH-BRL
TRADING_TIMEFRAME=1h
LONG_ONLY=true

# Risk
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=5.0
MAX_POSITION_SIZE_PCT=20.0
MAX_EXPOSURE_PCT=100.0
CIRCUIT_BREAKER_PCT=10.0
MIN_CONFIDENCE=0.50
MANDATORY_STOP=true
MANDATORY_TAKE_PROFIT=true

# LLM
LLM_PROVIDER=kilo
LLM_API_KEY=changeme
LLM_BASE_URL=https://api.kilo.ai/api/gateway
LLM_MODEL=kilo-auto/free

# Exchange Credentials
SANDBOX_API_KEY=changeme
SANDBOX_API_SECRET=changeme
MB_API_KEY=changeme
MB_API_SECRET=changeme
LIVE_API_KEY=changeme
LIVE_API_SECRET=changeme

# Infrastructure
DATABASE_URL=postgresql+asyncpg://aegis:aegis@localhost:5432/aegis
DATABASE_ECHO=false
REDIS_URL=redis://localhost:6379/0

# API Authentication (production only)
AEGIS_API_KEY=changeme
